# Copy to .env for local runs. Never commit .env.
#
# The task itself reads the four "Task" keys below — add those to the Trigger.dev dashboard too:
# cloud.trigger.dev → your project → Environment Variables (Staging + Prod)

# ─── Trigger.dev (CLI + Kapso webhook, not read by the task) ───────────────────

# Project ref — cloud.trigger.dev → your project → Project settings (starts with proj_)
TRIGGER_PROJECT_REF=
# Prod secret key — cloud.trigger.dev → your project → API keys (starts with tr_prod_).
# Stored in the Kapso webhook's X-Trigger-Key header so the relay can start the task.
TRIGGER_SECRET_KEY=
# Personal access token for deploys — cloud.trigger.dev → Account → Personal Access Tokens (starts with tr_pat_)
TRIGGER_ACCESS_TOKEN=

# ─── Task: WhatsApp → Gmail forwarder ──────────────────────────────────────────

# Kapso API key — app.kapso.ai → Project settings → API keys. Used to download photos, voice notes and files
KAPSO_API_KEY=
# Gmail address that sends the forwarded emails
GMAIL_USER=
# 16-character App Password — myaccount.google.com/apppasswords (2-Step Verification must be on)
GMAIL_APP_PASSWORD=
# Inbox that receives forwarded WhatsApp messages (comma-separate several addresses)
FORWARD_TO_EMAIL=
